---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { ACTION_NETWORK, SITE } from '../config';
import fdiu from '../assets/fdiu.jpg';

const title = 'Frente Digital · Izquierda Unida';
const description = SITE.description;
---

<Base title={title} description={description}>
  <div class="page">
    <div class="container">
      <h1 class="sr-only">Frente Digital de Izquierda Unida</h1>
    </div>
    <div class="container page__grid">
      <figure class="intro__media">
          <Picture
            src={fdiu}
            alt="Cartel del Frente Digital de Izquierda Unida: un puño levantado sobre fondo rojo con el lema «Contra el fascismo» y el texto «Frente Digital»."
            formats={['webp']}
            fallbackFormat="jpg"
            widths={[540, 720, 1080]}
            sizes="(max-width: 600px) calc(100vw - 2rem), (max-width: 900px) calc(100vw - 3rem), 540px"
            quality={90}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>

      <div class="content">
        <div class="intro__body">
          <p>
            En <strong>momentos difíciles</strong>, toca juntarnos. La amenaza reaccionaria es real
            y nos va a encontrar más fuertes que nunca, <strong>hombro con hombro</strong>,
            defendiendo los derechos que hemos conquistado.
          </p>
          <p>
            <strong>Lanzamos el Frente Digital de Izquierda Unida</strong>: un espacio para
            organizar la resistencia y participar en las luchas, acciones y movilizaciones
            antifascistas.
          </p>
          <p>
            Las redes sociales no son neutrales. Están en manos de oligopolios digitales que
            silencian y manipulan nuestros contenidos. El Frente Digital es una{' '}
            <strong>red autónoma y soberana</strong> para conectar sin depender de sus algoritmos.
          </p>
          <p>
            Podrás conocer las convocatorias locales, movilizaciones y actividades que IU organiza
            en tu territorio, y participar en las acciones digitales que impulsamos.
          </p>
          <p>
            <strong>Es la hora de dar el paso.</strong>
          </p>
        </div>

        <div class="form-block">
          <form
            id="frente-digital-form"
            method="get"
            action={ACTION_NETWORK.publicFormUrl}
            data-endpoint={ACTION_NETWORK.submitUrl}
            data-success="/gracias"
            aria-label="Inscripción en el Frente Digital"
          >
          <div class="field">
            <label class="sr-only" for="first_name">Nombre</label>
            <input
              id="first_name"
              name="first_name"
              type="text"
              placeholder="Nombre"
              autocomplete="given-name"
              required
            />
          </div>

          <div class="field">
            <label class="sr-only" for="email">Correo electrónico</label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="Correo electrónico *"
              autocomplete="email"
              inputmode="email"
              autocapitalize="none"
              spellcheck="false"
              required
            />
          </div>

          <div class="field">
            <label class="sr-only" for="zip_code">Código postal</label>
            <input
              id="zip_code"
              name="zip_code"
              type="text"
              placeholder="Código postal *"
              autocomplete="postal-code"
              inputmode="numeric"
              maxlength="10"
              required
            />
          </div>

          <label class="consent" for="GDPR2">
            <input id="GDPR2" name="GDPR2" type="checkbox" value="1" required />
            <span>
              He leído y acepto la{' '}
              <a href={SITE.privacy} target="_blank" rel="noopener">política de privacidad</a>.
            </span>
          </label>

          <button class="btn-submit" type="submit">
            ¡Quiero unirme al Frente Digital de IU!
          </button>

          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>

          <p class="form-note">
            Al enviar el formulario aceptas que Izquierda Unida trate tus datos para gestionar tu
            participación en el Frente Digital y enviarte información. Puedes darte de baja cuando
            quieras. Más información en la <a href={SITE.privacy}>política de privacidad</a>.
          </p>

          <noscript>
            <p class="form-note">
              Para enviar el formulario necesitas JavaScript. También puedes{' '}
              <a href={ACTION_NETWORK.publicFormUrl}>hacerlo en Action Network</a>.
            </p>
          </noscript>
          </form>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  const form = document.getElementById('frente-digital-form');
  const status = document.getElementById('form-status');

  if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
    const endpoint = form.dataset.endpoint;
    const successUrl = form.dataset.success || '/gracias';
    const submitButton = form.querySelector('button[type="submit"]');

    const clearStatus = () => {
      status.textContent = '';
      status.classList.remove('is-error');
    };

    const showError = (message) => {
      status.textContent = message;
      status.classList.add('is-error');

      const fallback = document.createElement('a');
      fallback.href = 'https://actionnetwork.org/forms/frente-digital-iu';
      fallback.target = '_blank';
      fallback.rel = 'noopener';
      fallback.textContent = 'Abrir el formulario original';
      status.append(' ', fallback);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearStatus();

      if (!form.reportValidity()) return;

      if (!endpoint) {
        showError('El formulario no está configurado correctamente. Inténtalo más tarde.');
        return;
      }

      const data = new FormData(form);
      const firstName = String(data.get('first_name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const zipCode = String(data.get('zip_code') || '').trim();
      const gdprAccepted = data.get('GDPR2') === '1';

      if (!firstName || !email || !zipCode || !gdprAccepted) {
        showError('Revisa los campos obligatorios y acepta la política de privacidad.');
        return;
      }

      const payload = {
        person: {
          given_name: firstName,
          email_addresses: [{ address: email, status: 'subscribed' }],
          postal_addresses: [{ postal_code: zipCode, country: 'ES' }],
          custom_fields: { GDPR2: '1' },
        },
        'action_network:referrer_data': { source: 'frentedigital' },
        triggers: {
          autoresponse: { enabled: true },
        },
      };

      const originalLabel = submitButton?.textContent || '';
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.textContent = 'Enviando…';
      }
      form.setAttribute('aria-busy', 'true');

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          throw new Error(`Action Network respondió ${response.status}`);
        }

        window.location.assign(successUrl);
      } catch (error) {
        console.error('No se pudo enviar el formulario a Action Network', error);
        showError(
          'No hemos podido enviar el formulario. Inténtalo de nuevo en unos segundos o'
        );
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
          submitButton.textContent = originalLabel;
        }
        form.removeAttribute('aria-busy');
      }
    });
  }
</script>
